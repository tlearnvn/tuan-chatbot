# Chặn mọi truy cập trực tiếp vào thư mục này.
# Tệp chỉ được phục vụ qua api/download.php (đã kiểm tra quyền sở hữu).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# Vô hiệu hoá mọi khả năng thực thi mã, kể cả khi lớp chặn ở trên bị bỏ qua.
# php_flag chỉ hợp lệ với mod_php — phải bọc trong IfModule, nếu không máy chủ
# chạy PHP-FPM/CGI sẽ báo lỗi 500 ("Invalid command 'php_flag'").
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .jsp .asp .aspx .sh
  AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .jsp .asp .aspx .sh
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>
